#!/bin/bash
set -euo pipefail

if [ "$EUID" -ne 0 ]; then
    echo "Retorne à sessão de root com exit antes de gerar o comprovante."
    exit 1
fi

ARQUIVO="/root/.laboratorio-aluno"
VERIFICACOES="/usr/local/lib/laboratorio"

if [ ! -f "$ARQUIVO" ]; then
    echo "Aluno não identificado."
    exit 1
fi

# Reutiliza os mesmos critérios dos botões CHECK, sem duplicar as regras.
ETAPAS=("Identificação" "Grupos" "Usuários" "Configuração das contas" "Diretórios" "Permissões" "Teste de acesso e arquivos")
ERROS=0
for etapa in 0 1 2 3 4 5 6; do
    SCRIPT="$VERIFICACOES/verify-step$etapa.sh"
    if [ ! -f "$SCRIPT" ]; then
        echo "Verificação indisponível: ${ETAPAS[$etapa]}. Reinicie o laboratório em uma nova sessão."
        ERROS=$((ERROS + 1))
    elif ! bash "$SCRIPT"; then
        echo "Requisito pendente: ${ETAPAS[$etapa]}."
        ERROS=$((ERROS + 1))
    fi
done
if [ "$ERROS" -ne 0 ]; then
    echo "Comprovante não emitido. Corrija os requisitos indicados e tente novamente."
    exit 1
fi

MATRICULA=$(sed -n 's/^MATRICULA=//p' "$ARQUIVO")
SESSAO=$(sed -n 's/^SESSAO=//p' "$ARQUIVO")
# Formato v1: UTF-8 sem BOM, linhas LF, ordem fixa e LF final.
# SHA-256 detecta alterações sem recálculo; não autentica a origem da VM.
DATA_FINAL=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
DIRETORIO="/root/comprovantes"
DESTINO="$DIRETORIO/usuarios-grupos_${MATRICULA}_${SESSAO}.txt"
mkdir -p "$DIRETORIO"
TEMPORARIO=$(mktemp "$DIRETORIO/.comprovante.XXXXXXXXXX")
trap 'rm -f -- "$TEMPORARIO"' EXIT

printf '%s\n' \
    'VERSAO=1' \
    'LABORATORIO=usuarios-grupos' \
    "MATRICULA=$MATRICULA" \
    "SESSAO=$SESSAO" \
    "DATA=$DATA_FINAL" \
    'RESULTADO=CONCLUIDO' > "$TEMPORARIO"
CODIGO=$(sha256sum "$TEMPORARIO")
CODIGO=${CODIGO%% *}
printf 'CODIGO=SHA256:%s\n' "$CODIGO" >> "$TEMPORARIO"
chmod 644 "$TEMPORARIO"
# Publica somente o TXT completo. Nova geração substitui o da mesma sessão.
mv -fT -- "$TEMPORARIO" "$DESTINO"

printf '\nComprovante gerado: %s\n\n' "$DESTINO"
cat "$DESTINO"
printf '\nBaixe o arquivo pelo Editor: abra /root/comprovantes, clique com o botão direito no TXT e escolha Download.\n'
printf 'Envie o arquivo TXT baixado na atividade do Moodle, antes de encerrar o ambiente.\n'

if [ -s /usr/local/lib/laboratorio/drive-upload-url ]; then
    if ! enviar-comprovante; then
        echo "Comprovante gerado localmente, mas o envio ao Drive não foi confirmado."
        echo "Para repetir apenas o envio, execute enviar-comprovante."
    fi
else
    echo "Envio automático ao Drive ainda não configurado; use o download pelo Editor."
fi
